# Copy to .env and fill in real values. Never commit .env.
POSTGRES_USER=devsec
POSTGRES_PASSWORD=change-me-in-real-deployments
POSTGRES_DB=devsec

# Groq keys. Use either one key or the numbered pool.
GROQ_API_KEY=
GROQ_API_KEY_1=
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GROQ_API_KEY_4=
GROQ_API_KEY_5=
GROQ_API_KEY_6=
GROQ_API_KEY_7=
GROQ_API_KEY_8=
GROQ_API_KEY_9=
GROQ_API_KEY_10=
GROQ_API_KEY_11=
GROQ_API_KEY_12=

PRIMARY_MODEL=qwen/qwen3.8-27b
FALLBACK_MODEL=qwen/qwen3.6-27b
SAFETY_NET_MODEL=openai/gpt-oss-120b

# Security (optional; API_KEY empty disables API-key auth for local use).
API_KEY=
RATE_LIMIT_PER_MINUTE=0
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:5500

# Operational tuning.
GROQ_TIMEOUT_SECONDS=45
GROQ_TOTAL_TIMEOUT_SECONDS=90
# Per-process ONNX CPU threads. Match this to the CPU budget divided by workers.
ONNX_INTRA_OP_THREADS=4
GROQ_MAX_ATTEMPTS=3
CIRCUIT_FAILURE_THRESHOLD=5
CIRCUIT_RECOVERY_SECONDS=30
SSE_HEARTBEAT_SECONDS=15
SSE_MAX_DURATION_SECONDS=300
REFRESH_INTERVAL_HOURS=6
# Internal Prometheus scrape port for the ingestion worker.
REFRESH_METRICS_PORT=9101
# Set false only for cache-bypass load tests; production keeps this true.
CACHE_ENABLED=true
UVICORN_WORKERS=1
LOG_LEVEL=INFO

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me
